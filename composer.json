{
    "name": "3neti/form-handler-document",
    "description": "Private document upload handler for form-flow",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "3neti/form-flow": "^1.11",
        "illuminate/support": "^12.0 || ^13.0",
        "spatie/laravel-medialibrary": "^11.21"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0 || ^3.0",
        "orchestra/testbench": "^10.3 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.2 || ^4.0"
    },
    "autoload": {"psr-4": {"LBHurtado\\FormHandlerDocument\\": "src/"}},
    "autoload-dev": {"psr-4": {"LBHurtado\\FormHandlerDocument\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["LBHurtado\\FormHandlerDocument\\DocumentHandlerServiceProvider"]}},
    "config": {"allow-plugins": {"pestphp/pest-plugin": true}, "sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
